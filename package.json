{
  "name": "hammerguys-party",
  "version": "0.2.0",
  "private": true,
  "description": "A party of chaotic minigames for up to 10 friends in the browser, inspired by the Warcraft III map Uther Party",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "preview": "vite preview --outDir dist",
    "serve": "VITE_TRANSPORT=ws vite build && node server.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "three": "^0.186.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "peer": "^1.0.2",
    "vite": "^8.3.1"
  }
}
